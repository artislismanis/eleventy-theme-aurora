{
  "contractVersion": 1,

  "capabilities": {
    "social": { "render": "icons", "fallback": "text" },
    "analytics": ["googleAnalytics", "plausible"],
    "comments": ["disqus"],
    "search": false
  },

  "themeFeatures": [
    {
      "name": "code-highlighting",
      "entry": "features/code-highlighting/index.js"
    },
    {
      "name": "back-to-top",
      "entry": "features/back-to-top/index.js"
    }
  ],

  "build": {
    "purgeCSS": {
      "safelist": {
        "deep": [
          "data-theme",
          "data-component",
          "aria-current",
          "language-",
          "code",
          "pre",
          "token",
          "diff-highlight",
          "back-to-top"
        ],
        "greedy": ["language-"]
      }
    },
    "postcss": {
      "plugins": [
        {
          "package": "postcss-preset-env",
          "options": {
            "stage": 3,
            "features": {
              "nesting-rules": true,
              "custom-properties": false,
              "custom-media-queries": true
            }
          }
        },
        {
          "package": "cssnano",
          "production": true,
          "options": {
            "preset": [
              "default",
              {
                "discardComments": { "removeAll": true },
                "normalizeWhitespace": true,
                "colormin": true,
                "minifyFontValues": true
              }
            ]
          }
        }
      ]
    }
  },

  "assets": {
    "styles": {
      "entry": "styles/main.scss"
    },
    "scripts": {
      "entry": "scripts/main.js"
    }
  },

  "config": {
    "themeToggle": {
      "defaultTheme": "auto",
      "showToggle": true
    },
    "colors": {
      "light": {
        "background": "#ffffff",
        "surface": "#deebf7",
        "primary": "#172c51",
        "secondary": "#5b9bd5",
        "accent": "#e8722e",
        "text": "#172c51",
        "textMuted": "#4a7cb5",
        "link": "#172c51",
        "linkHover": "#e8722e",
        "linkVisited": "#172c51",
        "border": "#c5d8ee"
      },
      "dark": {
        "background": "#0e1b30",
        "surface": "#172c51",
        "primary": "#deebf7",
        "secondary": "#5b9bd5",
        "accent": "#e8722e",
        "text": "#d8e5f4",
        "textMuted": "#92b0d4",
        "link": "#a8cbed",
        "linkHover": "#e8722e",
        "linkVisited": "#a8cbed",
        "border": "#2b4670"
      }
    },
    "typography": {
      "fontFamily": "-apple-system, system-ui, sans-serif",
      "fontFamilyHeading": "inherit",
      "fontFamilyMono": "'Consolas', 'Monaco', monospace",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "navigation": {
      "showHomeLink": true,
      "pagination": {
        "enabled": true,
        "pageSize": 10
      }
    },
    "codeHighlighting": {
      "prismTheme": "prism-tomorrow",
      "diffHighlight": true
    },
    "footer": {
      "copyright": " © {year} {site.title}",
      "alignment": "center",
      "showPoweredBy": true,
      "showGitSha": true
    }
  }
}
